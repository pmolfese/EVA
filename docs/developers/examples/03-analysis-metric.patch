 /// The pipeline is segment quality → retained data → spectral power/connectivity
 /// → exportable summaries. Channel and sample indices are zero-based internally.
 nonisolated enum EEGAnalysisEngine {
+    /// A dimensionless coverage fraction; invalid or overlapping totals are unavailable.
+    static func retainedDurationFraction(included: Double, total: Double) -> Double? {
+        guard included.isFinite, total.isFinite, total > 0,
+              included >= 0, included <= total else { return nil }
+        return included / total
+    }
