+import Foundation
+import Testing
+@testable import EVA
+
+struct GuideRetentionMetricTests {
+    @Test func fractionHasExplicitUnitsAndMissingValuePolicy() {
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: 5, total: 10) == 0.5)
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: 0, total: 10) == 0)
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: 10, total: 10) == 1)
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: 1, total: 0) == nil)
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: 11, total: 10) == nil)
+        #expect(EEGAnalysisEngine.retainedDurationFraction(included: .nan, total: 10) == nil)
+    }
+}
