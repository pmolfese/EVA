+import Foundation
+import Testing
+@testable import EVA
+
+@MainActor
+struct GuideFilterParameterTests {
+    private func signal(_ data: [[Float]]) -> MFFSignalData {
+        MFFSignalData(signalURL: URL(fileURLWithPath: "/tmp/guide.raw"),
+            signalType: "EEG", numberOfChannels: data.count, samplingRate: 1000,
+            duration: Double(data[0].count) / 1000, recordingStartTime: nil,
+            events: [], data: data)
+    }
+
+    @Test func xmlRoundTripAndMissingLegacyKey() throws {
+        let model = FilterViewModel(store: RecordingStore())
+        model.invertEEGPolarity = true
+        var script = EVAProcessingScript()
+        script.append(EVAProcessingStep(operation: .filter, parameters: model.parameters))
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: folder) }
+        try EVAProcessingScriptXML.write(script, toPackage: folder)
+        let saved = try #require(EVAProcessingScriptXML.read(fromPackage: folder))
+        let parameters = try #require(saved.steps.first?.parameters)
+        let restored = FilterViewModel(store: RecordingStore())
+        restored.apply(parameters: parameters)
+        #expect(restored.invertEEGPolarity)
+        #expect(restored.parameters == model.parameters)
+        restored.apply(parameters: [:])
+        #expect(!restored.invertEEGPolarity)
+        restored.invertEEGPolarity = true
+        restored.resetToDefaults()
+        #expect(!restored.invertEEGPolarity)
+    }
+
+    @Test func liveAndRestoredSettingsProduceIdenticalSamples() async throws {
+        let input = signal([[1, -2, 3, -4], [4, 3, 2, 1]])
+        let live = FilterViewModel(store: RecordingStore())
+        live.highPassCutoffText = ""
+        live.lowPassCutoffText = ""
+        live.averageReference = false
+        live.lineNoiseMode = .off
+        live.invertEEGPolarity = true
+        live.filterPNS = true
+        var committed = 0
+        await live.apply(to: input, pnsInput: input, onApplied: { committed += 1 })
+        let output = try #require(live.output)
+        #expect(committed == 1)
+        #expect(live.pnsOutput?.data == input.data)
+        #expect(output.data == [[-1, 2, -3, 4], [-4, -3, -2, -1]])
+        #expect(output.dataRevision != input.dataRevision)
+        let restored = FilterViewModel(store: RecordingStore())
+        restored.apply(parameters: live.parameters)
+        await restored.apply(to: input, pnsInput: nil, onApplied: {})
+        #expect(restored.output?.data == output.data)
+        #expect(input.data[0] == [1, -2, 3, -4])
+    }
+
+    @Test func recordedRunsCarryTheOptionAndPreserveGaps() async throws {
+        let output = try await FilterViewModel.filteredChannels(
+            [[1, 2, 99, 3, 4]], samplingRate: 1000,
+            lowCutoff: nil, highCutoff: nil, lineNoiseMode: .off,
+            notchFrequency: 60, lineNoiseHarmonics: 2, lineNoiseWindowSeconds: 4,
+            lineNoiseStrength: 1, averageReference: false, invertEEGPolarity: true,
+            excludedChannels: [], recordedRanges: [0..<2, 3..<5], progress: { _ in })
+        #expect(output == [[-1, -2, 0, -3, -4]])
+    }
+}
