+import Foundation
+
+/// Teaching format: version 1 JSON, channel-major EEG arrays in microvolts.
+nonisolated enum DemoSignalReader {
+    private struct Document: Decodable {
+        let version: Int
+        let samplingRateHz: Double
+        let channelNames: [String]
+        let samplesMicrovolts: [[Float]]
+    }
+
+    static func load(from url: URL) throws -> ImportedRecording {
+        let bytes = try Data(contentsOf: url, options: .mappedIfSafe)
+        guard bytes.count <= 1_048_576 else {
+            throw SignalImportError.malformedFile(url, "Demo input exceeds 1 MiB.")
+        }
+        let document: Document
+        do { document = try JSONDecoder().decode(Document.self, from: bytes) }
+        catch { throw SignalImportError.malformedFile(url, "Invalid demo JSON: \(error.localizedDescription)") }
+        guard document.version == 1 else {
+            throw SignalImportError.unsupportedVariant(url, "Expected demo format version 1.")
+        }
+        let data = document.samplesMicrovolts
+        guard document.samplingRateHz.isFinite, document.samplingRateHz > 0,
+              let count = data.first?.count, count > 0,
+              data.count == document.channelNames.count,
+              Set(document.channelNames).count == data.count,
+              document.channelNames.allSatisfy({ !$0.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }),
+              data.allSatisfy({ $0.count == count && $0.allSatisfy(\.isFinite) }) else {
+            throw SignalImportError.malformedFile(url, "Expected unique channel names, a positive rate, and rectangular finite samples.")
+        }
+        let duration = Double(count) / document.samplingRateHz
+        guard duration.isFinite else {
+            throw SignalImportError.malformedFile(url, "Sampling rate produces an invalid duration.")
+        }
+        let signal = MFFSignalData(signalURL: url, signalType: "EEG",
+            numberOfChannels: data.count, samplingRate: document.samplingRateHz,
+            duration: duration, recordingStartTime: nil,
+            events: [], data: data, channelNames: document.channelNames,
+            channelUnits: Array(repeating: "uV", count: data.count))
+        return ImportedRecording(signal: signal, layout: nil, geometry: nil, pnsSignal: nil)
+    }
+}
