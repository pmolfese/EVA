+//  Developed by P. Molfese, National Institutes of Health (NIH).
+//
+//  This software is a "work of the United States Government" prepared by a federal
+//  employee as part of official duties. As such, it is not subject to copyright
+//  protection within the United States (17 U.S.C. § 105). International copyrights
+//  may apply.
+
+import Foundation
+import Testing
+@testable import EVA
+
+struct GuideDemoReaderTests {
+    private func withFile(_ text: String, body: (URL) async throws -> Void) async throws {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + ".evademo")
+        try Data(text.utf8).write(to: url)
+        defer { try? FileManager.default.removeItem(at: url) }
+        try await body(url)
+    }
+
+    @Test func dispatcherImportsAndMFFExportPreservesSamples() async throws {
+        let json = #"{"version":1,"samplingRateHz":1000,"channelNames":["Demo1","Demo2"],"samplesMicrovolts":[[1,-2,3,4],[4,3,-2,1]]}"#
+        try await withFile(json) { url in
+            #expect(SignalImportReader.isSupportedRecordingURL(url))
+            let imported = try SignalImportReader.load(from: url)
+            #expect(imported.signal.data[0] == [1, -2, 3, 4])
+            #expect(imported.signal.samplingRate == 1000)
+            #expect(imported.signal.duration == 0.004)
+            #expect(imported.signal.channelNames == ["Demo1", "Demo2"])
+            #expect(imported.pnsSignal == nil)
+            let output = url.deletingPathExtension().appendingPathExtension("mff")
+            defer { try? FileManager.default.removeItem(at: output) }
+            let result = await MFFExportWriter.write(
+                snapshot: MFFExportSnapshot(signal: imported.signal, segments: [], kind: .continuous),
+                pnsSignal: nil, script: EVAProcessingScript(), to: output)
+            let package = try result.get()
+            let restored = try MFFReader().loadSignal(from: package)
+            #expect(restored.data == imported.signal.data)
+            #expect(restored.channelNames == imported.signal.channelNames)
+        }
+    }
+
+    @Test(arguments: [
+        #"{"version":2,"samplingRateHz":1000,"channelNames":["A"],"samplesMicrovolts":[[1]]}"#,
+        #"{"version":1,"samplingRateHz":0,"channelNames":["A"],"samplesMicrovolts":[[1]]}"#,
+        #"{"version":1,"samplingRateHz":1000,"channelNames":["A","B"],"samplesMicrovolts":[[1],[1,2]]}"#,
+        #"{"version":1,"samplingRateHz":1000,"channelNames":["A","A"],"samplesMicrovolts":[[1],[2]]}"#,
+        #"{"version":1,"samplingRateHz":1000,"channelNames":[],"samplesMicrovolts":[]}"#,
+        "not JSON"
+    ])
+    func malformedInputIsRejected(_ json: String) async throws {
+        try await withFile(json) { url in
+            #expect(throws: (any Error).self) { try DemoSignalReader.load(from: url) }
+        }
+    }
+}
